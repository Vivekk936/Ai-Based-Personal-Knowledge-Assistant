# Leave everything unset to run entirely against local Ollama (zero-config dev mode).

# --- OpenRouter (uncomment to switch chat/vision to it) ---
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_API_KEY=sk-or-...
# CHAT_MODEL=qwen/qwen-2.5-72b-instruct

# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=sk-or-...
# VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct

# --- NVIDIA NIM ---
# CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
# CHAT_API_KEY=nvapi-...
# CHAT_MODEL=meta/llama-3.1-70b-instruct

# Embeddings can stay local (nomic-embed-text via Ollama) even when chat/vision are hosted —
# no reason to pay a per-call API for embeddings during dev.
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_MODEL=nomic-embed-text
