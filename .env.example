# ==============================================================================
# Ada — NVIDIA NIM Configuration (.env.example)
# ==============================================================================

# Your NVIDIA API Key (obtain from https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# Base URL for NVIDIA NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
# Chat & Agent Model (nvidia/nemotron-3.5-lightning-30b-a3b or meta/llama-3.1-70b-instruct)
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Multimodal Vision Model for OCR & Document Reading
VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Embeddings Model for Dense Vector DB Retrieval
EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Optional Custom Overrides (uncomment if using dedicated endpoints)
# CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
# CHAT_API_KEY=nvapi-...
# VISION_BASE_URL=https://integrate.api.nvidia.com/v1
# VISION_API_KEY=nvapi-...
# EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBED_API_KEY=nvapi-...

# System Settings
REQUEST_TIMEOUT_SECONDS=120
REQUEST_MAX_RETRIES=2
EMBED_BATCH=64

